// ─────────────────────────────────────────────────────────────────────────────
// AgencyHub — Prisma Schema
// Key invariants (enforced in app code + schema structure):
//   • Every tenant table carries agency_id (NOT NULL, indexed).
//   • progress is NEVER stored — always derived from tasks.
//   • Soft-delete is NOT used in MVP — hard delete with FK cascade.
//   • IDs are UUID CHAR(36) to avoid enumerable sequential IDs.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum AgencyPlan {
  FREE
  PRO
}

enum UserRole {
  SUPER_ADMIN
  AGENCY_ADMIN
  AGENCY_MEMBER
  CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// Milestone client-approval lifecycle
enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  IN_PROGRESS
  RESOLVED
  DECLINED
}

// Who performed an activity log action
enum ActorType {
  USER
  CLIENT
  SYSTEM
  SUPER_ADMIN
}

// Invite tokens are only for agency team members (not clients, not super admins)
enum InvitationRole {
  AGENCY_ADMIN
  AGENCY_MEMBER
}

// ─── Core tenant model ───────────────────────────────────────────────────────

model Agency {
  id              String       @id @default(uuid()) @db.Char(36)
  name            String       @db.VarChar(255)
  slug            String       @unique @db.VarChar(100)
  ownerName       String       @map("owner_name") @db.VarChar(255)
  contactEmail    String       @map("contact_email") @db.VarChar(255)
  contactPhone    String?      @map("contact_phone") @db.VarChar(50)
  status          AgencyStatus @default(ACTIVE)
  plan            AgencyPlan   @default(FREE)
  suspendedReason String?      @map("suspended_reason") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  users            User[]
  clients          Client[]
  projects         Project[]
  projectMembers   ProjectMember[]
  milestones       Milestone[]
  tasks            Task[]
  taskComments     TaskComment[]
  meetings         Meeting[]
  feedback         Feedback[]
  feedbackComments FeedbackComment[]
  files            File[]
  activityLogs     ActivityLog[]
  invitations      Invitation[]

  @@map("agencies")
}

// ─── Users (all roles in one table) ─────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  // SUPER_ADMIN: agency_id = null, client_id = null
  // AGENCY_ADMIN/MEMBER: agency_id = set, client_id = null
  // CLIENT: agency_id = set (owning agency), client_id = set
  agencyId     String?   @map("agency_id") @db.Char(36)
  clientId     String?   @map("client_id") @db.Char(36)
  name         String    @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Named relations required because User is referenced multiple times from Task
  managedProjects   Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]
  assignedTasks     Task[]          @relation("TaskAssignee")
  createdTasks      Task[]          @relation("TaskCreator")
  taskComments      TaskComment[]
  createdMeetings   Meeting[]
  submittedFeedback Feedback[]
  feedbackComments  FeedbackComment[]
  uploadedFiles     File[]

  @@index([agencyId])
  @@index([clientId])
  @@map("users")
}

// ─── Clients (agency's customers) ───────────────────────────────────────────

model Client {
  id          String   @id @default(uuid()) @db.Char(36)
  agencyId    String   @map("agency_id") @db.Char(36)
  companyName String   @map("company_name") @db.VarChar(255)
  contactName String   @map("contact_name") @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agency   Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  users    User[]     // Portal-login users for this client
  projects Project[]
  feedback Feedback[]

  @@index([agencyId])
  @@map("clients")
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String          @id @default(uuid()) @db.Char(36)
  agencyId    String          @map("agency_id") @db.Char(36)
  clientId    String          @map("client_id") @db.Char(36)
  managerId   String          @map("manager_id") @db.Char(36)
  name        String          @db.VarChar(255)
  description String?         @db.Text
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  startDate   DateTime?       @map("start_date") @db.Date
  dueDate     DateTime?       @map("due_date") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  agency  Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager User   @relation("ProjectManager", fields: [managerId], references: [id])

  members      ProjectMember[]
  milestones   Milestone[]
  tasks        Task[]
  meetings     Meeting[]
  feedback     Feedback[]
  files        File[]
  activityLogs ActivityLog[]

  @@index([agencyId])
  @@index([clientId])
  @@index([managerId])
  @@map("projects")
}

// ─── Project membership (controls what members can see) ──────────────────────

model ProjectMember {
  id        String   @id @default(uuid()) @db.Char(36)
  agencyId  String   @map("agency_id") @db.Char(36)
  projectId String   @map("project_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([agencyId])
  @@index([userId])
  @@map("project_members")
}

// ─── Milestones ───────────────────────────────────────────────────────────────

model Milestone {
  id                    String          @id @default(uuid()) @db.Char(36)
  agencyId              String          @map("agency_id") @db.Char(36)
  projectId             String          @map("project_id") @db.Char(36)
  title                 String          @db.VarChar(255)
  description           String?         @db.Text
  dueDate               DateTime?       @map("due_date") @db.Date
  status                MilestoneStatus @default(PENDING)
  // Sort order for display; updated via PATCH; no drag-and-drop in MVP
  sortOrder             Int             @default(0) @map("sort_order")
  requiresClientApproval Boolean        @default(false) @map("requires_client_approval")
  approvalStatus        ApprovalStatus  @default(NONE) @map("approval_status")
  // Raw user ID (not a FK relation) — avoids circular relation complexity
  approvedBy            String?         @map("approved_by") @db.Char(36)
  approvedAt            DateTime?       @map("approved_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([agencyId])
  @@index([projectId])
  @@map("milestones")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(uuid()) @db.Char(36)
  agencyId    String       @map("agency_id") @db.Char(36)
  projectId   String       @map("project_id") @db.Char(36)
  milestoneId String?      @map("milestone_id") @db.Char(36)
  title       String       @db.VarChar(255)
  description String?      @db.Text
  assigneeId  String?      @map("assignee_id") @db.Char(36)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date") @db.Date
  // Set automatically when status transitions to DONE
  completedAt DateTime?    @map("completed_at")
  createdBy   String       @map("created_by") @db.Char(36)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator   User       @relation("TaskCreator", fields: [createdBy], references: [id])
  comments  TaskComment[]

  @@index([agencyId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@map("tasks")
}

// ─── Task comments ────────────────────────────────────────────────────────────

model TaskComment {
  id        String   @id @default(uuid()) @db.Char(36)
  agencyId  String   @map("agency_id") @db.Char(36)
  taskId    String   @map("task_id") @db.Char(36)
  authorId  String   @map("author_id") @db.Char(36)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([agencyId])
  @@index([taskId])
  @@map("task_comments")
}

// ─── Meetings ─────────────────────────────────────────────────────────────────

model Meeting {
  id              String   @id @default(uuid()) @db.Char(36)
  agencyId        String   @map("agency_id") @db.Char(36)
  projectId       String   @map("project_id") @db.Char(36)
  title           String   @db.VarChar(255)
  meetingDate     DateTime @map("meeting_date") @db.Date
  notes           String?  @db.LongText
  // false by default — must be explicitly shared with clients
  visibleToClient Boolean  @default(false) @map("visible_to_client")
  // Stored JSON: { summary, decisions[], actionItems[{title, assigneeHint, dueDate}] }
  aiSummary       Json?    @map("ai_summary")
  createdBy       String   @map("created_by") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([agencyId])
  @@index([projectId])
  @@map("meetings")
}

// ─── Client feedback ─────────────────────────────────────────────────────────

model Feedback {
  id          String         @id @default(uuid()) @db.Char(36)
  agencyId    String         @map("agency_id") @db.Char(36)
  projectId   String         @map("project_id") @db.Char(36)
  // The client entity (not the user); used for client-scoped filtering
  clientId    String         @map("client_id") @db.Char(36)
  // The actual portal user who submitted; must have role=CLIENT and match clientId
  submittedBy String         @map("submitted_by") @db.Char(36)
  title       String         @db.VarChar(255)
  description String         @db.Text
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  agency    Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submitter User              @relation(fields: [submittedBy], references: [id])
  comments  FeedbackComment[]

  @@index([agencyId])
  @@index([projectId])
  @@index([clientId])
  @@map("feedback")
}

// ─── Feedback comments ────────────────────────────────────────────────────────

model FeedbackComment {
  id         String   @id @default(uuid()) @db.Char(36)
  agencyId   String   @map("agency_id") @db.Char(36)
  feedbackId String   @map("feedback_id") @db.Char(36)
  authorId   String   @map("author_id") @db.Char(36)
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([agencyId])
  @@index([feedbackId])
  @@map("feedback_comments")
}

// ─── Files ────────────────────────────────────────────────────────────────────

model File {
  id              String   @id @default(uuid()) @db.Char(36)
  agencyId        String   @map("agency_id") @db.Char(36)
  // project is always required; task/feedback are optional context links
  projectId       String   @map("project_id") @db.Char(36)
  taskId          String?  @map("task_id") @db.Char(36)
  feedbackId      String?  @map("feedback_id") @db.Char(36)
  uploadedBy      String   @map("uploaded_by") @db.Char(36)
  originalName    String   @map("original_name") @db.VarChar(255)
  // Random UUID used as the on-disk filename — never exposes original path
  storageKey      String   @unique @map("storage_key") @db.Char(36)
  mimeType        String   @map("mime_type") @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  // false by default — must be explicitly shared
  visibleToClient Boolean  @default(false) @map("visible_to_client")
  createdAt       DateTime @default(now()) @map("created_at")

  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([agencyId])
  @@index([projectId])
  @@map("files")
}

// ─── Activity logs ────────────────────────────────────────────────────────────
// agency_id is nullable — platform-level events (Super Admin actions) have no agency.
// Two query paths:
//   • ActivityRepo (scoped)         → always adds agency_id filter (used by agency/client)
//   • PlatformActivityRepo (raw)    → used only by Super Admin routes (role-guarded)

model ActivityLog {
  id              String    @id @default(uuid()) @db.Char(36)
  agencyId        String?   @map("agency_id") @db.Char(36)
  actorType       ActorType @map("actor_type")
  // Raw actor ID — polymorphic (User, Client, SYSTEM); no FK to avoid complexity
  actorId         String?   @map("actor_id") @db.Char(36)
  eventType       String    @map("event_type") @db.VarChar(100)
  entityType      String?   @map("entity_type") @db.VarChar(50)
  entityId        String?   @map("entity_id") @db.Char(36)
  projectId       String?   @map("project_id") @db.Char(36)
  visibleToClient Boolean   @default(false) @map("visible_to_client")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")

  agency  Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([projectId, createdAt])
  @@map("activity_logs")
}

// ─── Team invitations ─────────────────────────────────────────────────────────
// Tokens are random UUIDs stored as bcrypt hash; raw token returned once in response.
// Only AGENCY_ADMIN and AGENCY_MEMBER roles can be invited (not CLIENT, not SUPER_ADMIN).

model Invitation {
  id        String         @id @default(uuid()) @db.Char(36)
  agencyId  String         @map("agency_id") @db.Char(36)
  email     String         @db.VarChar(255)
  role      InvitationRole
  // bcrypt hash of the raw token — never stored in plaintext
  tokenHash String         @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("invitations")
}
