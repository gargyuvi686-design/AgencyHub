# ─── Database ──────────────────────────────────────────────────────────────────
# Native MySQL 8: mysql://root:YOUR_ROOT_PASSWORD@localhost:3306/agencyhub
# After installing MySQL 8 natively, create the DB: CREATE DATABASE agencyhub CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://root:YOUR_DB_PASSWORD@localhost:3306/agencyhub

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Must be a long random string (≥ 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (Next.js dev + prod URLs)
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ─── File storage ──────────────────────────────────────────────────────────────
# Absolute path where uploaded files are stored (never publicly served)
UPLOAD_DIR=./uploads

# ─── AI (Anthropic Claude) ─────────────────────────────────────────────────────
# Leave empty to disable AI features gracefully (503 response)
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
